# API de BaleadaFit (repo hermano ../baleadafit-api)
API_URL=http://localhost:3000
# Bypass de desarrollo mientras no haya sesion: dev:<uid>:<correo>
API_DEV_TOKEN=dev:nutri-1:nutri@correo.hn

# Firebase Web App. Esta config es publica (viaja en el bundle del cliente),
# asi que se versiona. Nunca pongas aca credenciales de service account.
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=baleadafit.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=baleadafit
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=baleadafit.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=840274381799
NEXT_PUBLIC_FIREBASE_APP_ID=1:840274381799:web:fd2a69767d20188ed4cb42
